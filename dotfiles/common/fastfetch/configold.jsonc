{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "padding": {
      "top": 2,
    },
  },
  "display": {
    "separator": " - ",
  },
  "modules": [
    {
      "type": "title",
      "keyWidth": 10,
    },
    {
      "type": "os",
      "key": "{icon} OS",
      "keyColor": "blue",
    },
    {
      "type": "kernel",
      "key": "  ├",
      "keyColor": "blue",
    },
    {
      "type": "packages",
      "key": "  ├󰏖",
      "keyColor": "blue",
    },
    {
      "type": "command",
      "key": "  ├",
      "keyColor": "blue",
      "shell": "/bin/bash",
      "text": "echo \"${TERM#xterm-} ($(basename $SHELL))\"",
    },
    {
      "type": "wm",
      "key": "  └",
      "keyColor": "blue",
    },
    {
      "type": "host",
      "key": "󰌢 PC",
      "keyColor": "green",
    },
    {
      "type": "cpu",
      "key": "  ├󰻠",
      "keyColor": "green",
    },
    {
      "type": "gpu",
      "key": "  ├󰍛",
      "keyColor": "green",
    },
    {
      "type": "disk",
      "key": "  ├",
      "keyColor": "green",
    },
    {
      "type": "memory",
      "key": "  ├󰑭",
      "keyColor": "green",
    },
    {
      "type": "uptime",
      "key": "  ├󰅐",
      "keyColor": "green",
    },
    {
      "type": "display",
      "key": "  ├󰍹",
      "keyColor": "green",
    },
    {
      "type": "media",
      "key": "  └󰝚",
      "keyColor": "green",
    },
    "break",
    {
      "type": "custom",
      "format": " {#90}  {#31}  {#32}  {#33}  {#34}  {#35}  {#36}  {#37}  {#38}  {#39}       {#38}  {#37}  {#36}  {#35}  {#34}  {#33}  {#32}  {#31}  {#90}",
    },
  ],
}
